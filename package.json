{
  "name": "root",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "author": "Amazon Web Services",
  "repository": "https://github.com/aws/amazon-q-developer-cli",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "b": "turbo build",
    "format": "cargo +nightly fmt",
    "clippy": "cargo clippy --locked --workspace --color always -- -D warnings",
    "test": "vitest",
    "test:ci": "vitest run --run --coverage",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "lint": "turbo lint --parallel",
    "lint:fix": "turbo lint:fix --parallel",
    "dev": "turbo dev",
    "dev:autocomplete": "pnpm -C packages/autocomplete-app dev",
    "dev:dashboard": "pnpm -C packages/dashboard-app dev",
    "preview:autocomplete": "pnpm -C packages/autocomplete-app preview",
    "preview:dashboard": "pnpm -C packages/dashboard-app preview",
    "clean": "turbo clean --parallel",
    "app": "bash scripts/build-app.sh"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.8",
    "@vitest/ui": "^3.0.8",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "micromatch": "^4.0.8",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "turbo": "^2.5.2",
    "vitest": "^3.0.8"
  }
}
